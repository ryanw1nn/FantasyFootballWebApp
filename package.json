{
  "name": "fantasy-football-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate",
    "db:migrate": "node db/migrate.mjs",
    "db:status": "node db/migrate.mjs status",
    "db:check": "node db/check-env.mjs",
    "db:import": "node db/import.mjs",
    "db:recompute": "node db/recompute.mjs",
    "db:verify": "node db/verify.mjs",
    "db:season": "node db/new-season.mjs",
    "db:player": "node db/player-status.mjs",
    "db:team": "node db/rename-team.mjs",
    "db:passphrase": "node db/passphrase.mjs",
    "api:auth": "node scripts/auth.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.11.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.552.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4"
  },
  "description": "",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanw1nn/FantasyFootballWebApp.git"
  },
